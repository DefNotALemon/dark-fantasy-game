static func text_width(text: String) -> int:
    ## Width in SOURCE pixels (before scale), outline not counted.
    var n := text.length()
    if n <= 0:
        return 0
    return n * (W + GAP) - GAP


static func _mask(text: String) -> Array:
    ## A 1 px margin all round so the outline dilate has somewhere to land.
    var up := text.to_upper()
    var gw := text_width(up) + 2
    var gh := H + 2
    var rows: Array = []
    for y in range(gh):
        var r := PackedByteArray()
        r.resize(gw)
        rows.append(r)
    for i in range(up.length()):
        var ch := up[i]
        if not GLYPHS.has(ch):
            ch = " "
        var g: Array = GLYPHS[ch]
        var ox := 1 + i * (W + GAP)
        for y in range(H):
            var line: String = g[y]
            for x in range(W):
                if line[x] == "#":
                    rows[y + 1][ox + x] = 1
    return rows


static func render(text: String, col: Color, outline: Color, scale: int) -> ImageTexture:
    ## Paint the string at whole-number scale. Glyph pixels take `col`; every
    ## empty pixel touching one takes `outline`, which is the whole reason the
    ## words survive the backdrop's bright horizon.
    scale = maxi(1, scale)
    var rows := _mask(text)
    var gh: int = rows.size()
    var gw: int = 0
    if gh > 0:
        gw = (rows[0] as PackedByteArray).size()
    if gw <= 0 or gh <= 0:
        gw = 1
        gh = 1
    var img := Image.create(gw * scale, gh * scale, false, Image.FORMAT_RGBA8)
    img.fill(Color(0, 0, 0, 0))
    for y in range(gh):
        for x in range(gw):
            var on: bool = (rows[y] as PackedByteArray)[x] == 1
            var c := col
            if not on:
                if outline.a <= 0.0:
                    continue
                var near := false
                for dy in range(-1, 2):
                    for dx in range(-1, 2):
                        var ny := y + dy
                        var nx := x + dx
                        if ny < 0 or ny >= gh or nx < 0 or nx >= gw:
                            continue
                        if (rows[ny] as PackedByteArray)[nx] == 1:
                            near = true
                            break
                    if near:
                        break
                if not near:
                    continue
                c = outline
            img.fill_rect(Rect2i(x * scale, y * scale, scale, scale), c)
    return ImageTexture.create_from_image(img)


static func marker(col: Color, outline: Color, scale: int) -> ImageTexture:
    ## The little wedge that stands beside the row your eye is on.
    var art := [
        "##.....",
        "###....",
        "####...",
        "#####..",
        "######.",
        "#####..",
        "####...",
        "###....",
        "##.....",
    ]
    scale = maxi(1, scale)
    var gw := 9
    var gh := art.size() + 2
    var rows: Array = []
    for y in range(gh):
        var r := PackedByteArray()
        r.resize(gw)
        rows.append(r)
    for y in range(art.size()):
        var line: String = art[y]
        for x in range(line.length()):
            if line[x] == "#":
                rows[y + 1][x + 1] = 1
    var img := Image.create(gw * scale, gh * scale, false, Image.FORMAT_RGBA8)
    img.fill(Color(0, 0, 0, 0))
    for y in range(gh):
        for x in range(gw):
            var on: bool = (rows[y] as PackedByteArray)[x] == 1
            var c := col
            if not on:
                var near := false
                for dy in range(-1, 2):
                    for dx in range(-1, 2):
                        var ny := y + dy
                        var nx := x + dx
                        if ny < 0 or ny >= gh or nx < 0 or nx >= gw:
                            continue
                        if (rows[ny] as PackedByteArray)[nx] == 1:
                            near = true
                            break
                    if near:
                        break
                if not near:
                    continue
                c = outline
            img.fill_rect(Rect2i(x * scale, y * scale, scale, scale), c)
    return ImageTexture.create_from_image(img)
